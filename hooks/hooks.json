{
  "description": "Hand screenshots pasted into the MEGANE viewer to Claude with the next prompt",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
